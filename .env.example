MODEL_PROVIDER=deepseek
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=60
TRACE_ENABLED=true
CODEPILOT_INPUT_COST_PER_1M=0
CODEPILOT_OUTPUT_COST_PER_1M=0
# Local demonstration values only. Replace for other deployments.
CODEPILOT_API_KEYS=dev-local=alice|developer;review-local=bob|reviewer
CODEPILOT_ALLOWED_REPO_ROOTS=
CODEPILOT_SESSION_DB=.runtime/codepilot/approvals.sqlite3
CODEPILOT_EXECUTION_MODE=thread
REDIS_URL=redis://127.0.0.1:6379/0
CODEPILOT_REDIS_STREAM=codepilot:tasks
CODEPILOT_REDIS_GROUP=codepilot-workers
CODEPILOT_WORKER_NAME=
CODEPILOT_WORKER_MAX_SETUP_RETRIES=2
CODEPILOT_WORKER_RETRY_BACKOFF_SECONDS=1
CODEPILOT_WORKER_MAX_RETRY_BACKOFF_SECONDS=30
